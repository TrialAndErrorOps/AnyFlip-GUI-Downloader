<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AnyFlipDownloader</AssemblyName>
    <RootNamespace>AnyFlipDownloader</RootNamespace>
    <AssemblyTitle>AnyFlip Downloader</AssemblyTitle>
    <Product>AnyFlip Downloader</Product>
    <Description>Download an authorized AnyFlip publication as a PDF.</Description>
    <Authors>TrialAndErrorOps</Authors>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\App.ico" />
    <EmbeddedResource Include="Tools\anyflip-downloader.exe" LogicalName="AnyFlipDownloader.Cli.exe" />
  </ItemGroup>
</Project>
